SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AI API Keys (at least one required for text generation)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here      # Also required for DALL-E image generation
GOOGLE_API_KEY=your-google-gemini-api-key-here

# Database (default: SQLite)
DB_ENGINE=sqlite
# For PostgreSQL, set DB_ENGINE=postgresql and fill these:
# DB_NAME=magzine
# DB_USER=magzine_user
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432
